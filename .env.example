# PetConnect AI — environment variable template.
# Copy to `.env` and fill with real values. NEVER commit the real `.env`.
# Loaded at runtime via flutter_dotenv. Values here are placeholders only.

# ── App / Flavor ───────────────────────────────────────────────
APP_ENV=dev                     # dev | staging | prod
APP_NAME=PetConnect AI (Dev)

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service-role key is server-side only (Edge Functions) — do NOT ship in app.

# ── Google Maps ────────────────────────────────────────────────
# Platform-restricted keys are configured natively (AndroidManifest / AppDelegate).
# This is only for optional runtime use; keep restricted.
GOOGLE_MAPS_API_KEY=YOUR_MAPS_API_KEY

# ── AI (Gemini) ────────────────────────────────────────────────
# The Gemini key lives ONLY in Supabase Edge Functions, never in the app.
# The app calls an Edge Function endpoint, not Gemini directly.
AI_EDGE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ai

# ── Firebase Cloud Messaging ───────────────────────────────────
# FCM config comes from google-services.json / GoogleService-Info.plist.
# Optional sender id for reference:
FCM_SENDER_ID=YOUR_FCM_SENDER_ID

# ── Smart Collar ───────────────────────────────────────────────
COLLAR_INGEST_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/collar-ingest

# ── n8n Automation ─────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://your-n8n-host/webhook

# ── Feature Flags (optional) ───────────────────────────────────
FEATURE_SMART_COLLAR=true
FEATURE_AI_ASSISTANT=true
