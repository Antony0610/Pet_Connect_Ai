{
  "version": 2,
  "rewrites": [
    { "source": "/verify/vaccine/(.*)", "destination": "/verify.html" },
    { "source": "/verify/report(.*)", "destination": "/verify.html" },
    { "source": "/verify/(.*)", "destination": "/verify.html" },
    { "source": "/verify", "destination": "/verify.html" },
    { "source": "/emergency/(.*)", "destination": "/emergency.html" },
    { "source": "/emergency", "destination": "/emergency.html" },
    { "source": "/adopt/(.*)", "destination": "/adopt.html" },
    { "source": "/adopt", "destination": "/adopt.html" },
    { "source": "/missing/(.*)", "destination": "/missing.html" },
    { "source": "/missing", "destination": "/missing.html" },
    { "source": "/passport/(.*)", "destination": "/emergency.html" },
    { "source": "/passport", "destination": "/emergency.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
